{
  "name": "@pureskillgg/mlabs-koa",
  "version": "13.0.0",
  "description": "Core middleware for Koa apps.",
  "type": "module",
  "main": "index.js",
  "exports": {
    "import": "./index.js",
    "default": "./index.js"
  },
  "module": "index.js",
  "sideEffects": false,
  "keywords": [
    "meltwater",
    "pureskillgg",
    "node"
  ],
  "homepage": "https://github.com/pureskillgg/mw-mlabs-koa",
  "bugs": "https://github.com/pureskillgg/mw-mlabs-koa/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pureskillgg/mw-mlabs-koa.git"
  },
  "license": "MIT",
  "author": {
    "name": "Evan Sosenko",
    "email": "evan@pureskill.gg"
  },
  "files": [
    "package-lock.json",
    "index.js",
    "lib"
  ],
  "scripts": {
    "test": "c8 ava",
    "pretest": "node index.js",
    "test:update": "ava --update-snapshots",
    "test:watch": "ava --watch",
    "test:debug": "ava debug --break",
    "lint": "npm-run-all --parallel lint:*",
    "lint:js": "eslint .",
    "lint:prettier": "prettier --check --ignore-path .gitignore '**/*.{js,cjs,mjs,json,yml,yaml,graphql}'",
    "prepublishOnly": "npm-run-all --parallel lint test",
    "preversion": "npm-run-all --parallel lint test",
    "postversion": "git push --follow-tags",
    "example": "node examples",
    "example:inspect": "node --inspect examples",
    "format": "npm-run-all --parallel format:*",
    "preformat": "prettier --write --ignore-path .gitignore '**/*.{js,cjs,mjs,json,yml,yaml,graphql}'",
    "format:js": "eslint --fix .",
    "report": "c8 report"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "uuid": "^14.0.1"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^15.7.0",
    "@pureskillgg/mlabs-health": "^3.0.0",
    "@pureskillgg/mlabs-logger": "^10.0.0",
    "@pureskillgg/phi": "^6.0.0",
    "awaiting": "^3.0.0",
    "awilix": "^13.0.5",
    "change-case": "^5.4.4",
    "chokidar": "^5.0.0",
    "confit": "^3.1.0",
    "koa": "^3.2.1",
    "koa-conditional-get": "^3.0.0",
    "koa-etag": "^5.0.0",
    "koa-favicon": "^2.1.0",
    "koa-helmet": "^9.0.0",
    "koa-logger": "^4.0.0",
    "koa-mount": "^4.2.0",
    "minimatch": "^10.2.5",
    "prom-client": "^15.1.3",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@pureskillgg/examplr": "^8.0.1",
    "ava": "^8.0.1",
    "c8": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "neostandard": "^0.13.0",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.9.4",
    "testdouble": "^3.20.2"
  }
}
